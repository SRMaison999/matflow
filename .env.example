# ===========================================
# MatFlow - Configuration Environment
# ===========================================
# Copier ce fichier en .env et adapter les valeurs

# ----- Application -----
NODE_ENV=development
APP_NAME=MatFlow
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ----- Server -----
PORT=4000
HOST=0.0.0.0

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql://matflow:matflow_dev_password@localhost:5432/matflow?schema=public

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- JWT Authentication -----
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ----- File Storage (MinIO/S3) -----
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=matflow
STORAGE_SECRET_KEY=matflow_minio_password
STORAGE_BUCKET=matflow-files

# ----- Email (optionnel) -----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@matflow.local

# ----- Logging -----
LOG_LEVEL=debug

# ----- CORS -----
CORS_ORIGIN=http://localhost:3000

# ----- Rate Limiting -----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
