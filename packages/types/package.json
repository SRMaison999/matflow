{
  "name": "@matflow/types",
  "version": "0.1.0",
  "private": true,
  "description": "Types TypeScript partages pour MatFlow",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./entities": {
      "import": "./src/entities/index.ts",
      "require": "./src/entities/index.ts",
      "types": "./src/entities/index.ts"
    },
    "./api": {
      "import": "./src/api/index.ts",
      "require": "./src/api/index.ts",
      "types": "./src/api/index.ts"
    },
    "./enums": {
      "import": "./src/enums/index.ts",
      "require": "./src/enums/index.ts",
      "types": "./src/enums/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
